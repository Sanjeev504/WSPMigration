@using WSPMigration.Models

<!-- 
Blazor Contact Card Component
Maps to WSP: Individual item in SUBLIST=CONTACTSLIST
Displays: Contact details with action buttons
-->

<div class="card contact-card h-100 shadow-sm border-0">
    <!-- Card Header -->
    <div class="card-header bg-gradient border-0 pb-0">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h5 class="card-title mb-1">
                    <i class="bi bi-person-circle me-2"></i>@Contact.ContactName
                </h5>
            </div>
            <span class="badge bg-info text-dark">@Contact.ContactType</span>
        </div>
    </div>

    <!-- Card Body -->
    <div class="card-body">
        <!-- Status Badge -->
        <div class="mb-3">
            @if (Contact.IsEnabled)
            {
                <span class="badge bg-success">
                    <i class="bi bi-check-circle"></i> Enabled
                </span>
            }
            else
            {
                <span class="badge bg-secondary">
                    <i class="bi bi-x-circle"></i> Disabled
                </span>
            }

            @if (Contact.CanChange)
            {
                <span class="badge bg-primary">
                    <i class="bi bi-pencil"></i> Editable
                </span>
            }
            else
            {
                <span class="badge bg-light text-dark">
                    <i class="bi bi-lock"></i> Read-Only
                </span>
            }
        </div>

        <!-- Contact Details -->
        <dl class="row contact-details">
            <dt class="col-sm-6">
                <small class="text-muted">Created By</small>
            </dt>
            <dd class="col-sm-6">
                <small>User ID: @Contact.CreatedBy</small>
            </dd>

            <dt class="col-sm-6">
                <small class="text-muted">Created Date</small>
            </dt>
            <dd class="col-sm-6">
                <small>@Contact.CreatedDate.ToString("MM/dd/yyyy HH:mm")</small>
            </dd>

            <dt class="col-sm-6">
                <small class="text-muted">Modified By</small>
            </dt>
            <dd class="col-sm-6">
                <small>User ID: @Contact.ModifiedBy</small>
            </dd>

            <dt class="col-sm-6">
                <small class="text-muted">Modified Date</small>
            </dt>
            <dd class="col-sm-6">
                <small>@Contact.ModifiedDate.ToString("MM/dd/yyyy HH:mm")</small>
            </dd>

            <dt class="col-sm-6">
                <small class="text-muted">Agency</small>
            </dt>
            <dd class="col-sm-6">
                <small>@Contact.Agency</small>
            </dd>
        </dl>
    </div>

    <!-- Card Footer with Actions -->
    <div class="card-footer bg-light border-0 pt-2">
        <div class="btn-group w-100" role="group">
            @if (CanDelete)
            {
                <button type="button"
                        class="btn btn-sm btn-outline-primary"
                        @onclick="() => OnEdit?.Invoke(Contact)"
                        title="Edit contact">
                    <i class="bi bi-pencil"></i> Edit
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-danger"
                        @onclick="() => OnDelete?.Invoke(Contact)"
                        title="Delete contact">
                    <i class="bi bi-trash"></i> Delete
                </button>
            }
            else
            {
                <span class="btn btn-sm btn-outline-secondary disabled w-100">
                    <i class="bi bi-lock"></i> Read-Only Contact
                </span>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// Contact data to display
    /// </summary>
    [Parameter]
    public ContactDto Contact { get; set; }

    /// <summary>
    /// Callback when edit is clicked
    /// </summary>
    [Parameter]
    public EventCallback<ContactDto> OnEdit { get; set; }

    /// <summary>
    /// Callback when delete is clicked
    /// </summary>
    [Parameter]
    public EventCallback<ContactDto> OnDelete { get; set; }

    /// <summary>
    /// Flag to show delete button
    /// Maps to WSP: canChange logic
    /// </summary>
    [Parameter]
    public bool CanDelete { get; set; } = false;
}

<style>
    .contact-card {
        transition: all 0.3s ease;
        overflow: hidden;
    }

    .contact-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15) !important;
    }

    .card-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        color: white;
    }

    .card-title {
        color: inherit;
        margin-bottom: 0;
    }

    .contact-details {
        margin-bottom: 0;
        font-size: 0.9rem;
    }

    .contact-details dt {
        font-weight: 600;
        padding-bottom: 0.25rem;
    }

    .contact-details dd {
        padding-bottom: 0.25rem;
    }

    .btn-group {
        gap: 0.25rem;
    }

    .btn-group .btn {
        flex: 1;
        border-radius: 0.25rem;
    }
</style>
