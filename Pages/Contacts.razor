@page "/contacts"
@rendermode InteractiveServer
@using WSPMigration.Models
@using WSPMigration.Services
@using System.Collections.Generic
@inject IContactService ContactService
@inject NavigationManager Navigation

<PageTitle>Contacts Add/Edit</PageTitle>

<div class="container-fluid mt-4">
    <!-- Header Section -->
    <div class="page-header mb-4">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="mb-0">
                    <i class="bi bi-person-lines-fill"></i> Contacts Add/Edit
                </h1>
                <small class="text-muted">ASC Policy Center - Contacts Management</small>
            </div>
            <div class="col-auto">
                <span class="badge bg-info">ASC ONLY</span>
            </div>
        </div>
    </div>

    <!-- Validation Status Alert -->
    @if (showValidationAlert && !isValid)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Access Denied</strong>
            <p class="mb-0">@validationMessage</p>
            <button type="button" class="btn-close" @onclick="DismissValidationAlert"></button>
        </div>
    }

    <!-- Loading State -->
    @if (isLoading)
    {
        <div class="alert alert-info">
            <div class="spinner-border spinner-border-sm me-2" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            Loading contacts...
        </div>
    }

    <!-- Error Alert -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error</strong>
            <p class="mb-0">@errorMessage</p>
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    <!-- Success Alert -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success</strong>
            <p class="mb-0">@successMessage</p>
            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
        </div>
    }

    <!-- Search/Filter Section (WSP: SEARCHFIELDS=Y) -->
    @if (isValid)
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0">
                    <i class="bi bi-search"></i> Search Contacts
                </h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="searchText" class="form-label">Search by Name or Type</label>
                        <div class="input-group">
                            <input type="text"
                                   id="searchText"
                                   class="form-control"
                                   placeholder="Enter search criteria..."
                                   @bind="searchText"
                                   @onkeyup="OnSearchKeyUp" />
                            <button class="btn btn-primary" type="button" @onclick="SearchContacts">
                                <i class="bi bi-search"></i> Search
                            </button>
                        </div>
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <button class="btn btn-outline-secondary w-100" @onclick="ResetSearch">
                            <i class="bi bi-arrow-clockwise"></i> Reset
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Contacts List Section (WSP: SUBLIST=CONTACTSLIST) -->
    @if (isValid && contactList != null)
    {
        if (contactList.Contacts.Count > 0)
        {
            <div class="contacts-section">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0">
                        <i class="bi bi-list-ul"></i> Contacts
                        <span class="badge bg-secondary">@contactList.Contacts.Count</span>
                    </h4>
                </div>

                <!-- Two-Column Grid Layout (WSP: LISTBREAKCOLUMNS=2) -->
                <div class="row g-3">
                    @foreach (var contact in contactList.Contacts)
                    {
                        <div class="col-lg-6 col-md-6">
                            <ContactCard Contact="contact" 
                                        OnEdit="EditContact" 
                                        OnDelete="DeleteContact"
                                        CanDelete="contact.CanChange" />
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No contacts found. Try adjusting your search criteria.
            </div>
        }
    }
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CancelDelete"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the contact <strong>@deleteConfirmContact?.ContactName</strong>?</p>
                <p class="text-muted small">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteContact">Delete</button>
            </div>
        </div>
    </div>
</div>

@code {
    // WSP Input Context Variables
    private int userId = 1;
    private string sessionId = "session_123";
    private string agency = "ASC";

    // UI State
    private bool isLoading = false;
    private bool isValid = false;
    private bool showValidationAlert = false;
    private string validationMessage = string.Empty;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    // Search State
    private string searchText = string.Empty;

    // Data State (WSP: SUBLIST=CONTACTSLIST, LISTSQL=@GETSECTION)
    private ContactListResponse contactList;

    // Delete Confirmation State
    private ContactDto deleteConfirmContact;
    private bool showDeleteConfirm = false;

    /// <summary>
    /// Component initialization
    /// Maps to WSP: REDIRECT_SECTION validation flow
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // In production, get these from authentication/session context
            // For now, using example values
            await ValidateAndLoadContacts();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error initializing page: {ex.Message}";
        }
    }

    /// <summary>
    /// Validates request and loads contacts
    /// Maps to WSP: REDIRECT_SECTION + LISTSQL=@GETSECTION
    /// Executes: up_asc_isValidRequest validation before loading data
    /// </summary>
    private async Task ValidateAndLoadContacts()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            // Step 1: Validate request (WSP: REDIRECT_SECTION)
            var (isValidRequest, validationMsg) = await ContactService.ValidateRequestAsync(
                userId, sessionId, agency);

            if (!isValidRequest)
            {
                isValid = false;
                validationMessage = validationMsg;
                showValidationAlert = true;
                return;
            }

            isValid = true;
            showValidationAlert = false;

            // Step 2: Load contacts list (WSP: LISTSQL=@GETSECTION)
            var request = new ContactListRequest
            {
                UserId = userId,
                SessionId = sessionId,
                Agency = agency,
                SearchText = searchText,
                BreakListColumn = "ContactType"
            };

            contactList = await ContactService.GetContactsListAsync(request);

            if (!contactList.IsValid)
            {
                errorMessage = contactList.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading contacts: {ex.Message}";
            isValid = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>
    /// Search contacts
    /// Maps to WSP: SEARCHFIELDS=Y
    /// </summary>
    private async Task SearchContacts()
    {
        await ValidateAndLoadContacts();
    }

    /// <summary>
    /// Reset search and reload all contacts
    /// </summary>
    private async Task ResetSearch()
    {
        searchText = string.Empty;
        await ValidateAndLoadContacts();
    }

    /// <summary>
    /// Handle search on Enter key
    /// </summary>
    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchContacts();
        }
    }

    /// <summary>
    /// Edit contact action
    /// Would navigate to edit page with contact details
    /// </summary>
    private void EditContact(ContactDto contact)
    {
        Navigation.NavigateTo($"/contacts/edit/{contact.ContactId}");
    }

    /// <summary>
    /// Delete contact action (with confirmation)
    /// Maps to WSP: DELETEsp=up_contacts_deleteContact
    /// </summary>
    private async Task DeleteContact(ContactDto contact)
    {
        deleteConfirmContact = contact;
        showDeleteConfirm = true;
        // In real Blazor app, would show modal using JS interop or component
        // For demo, confirming directly
        if (await ConfirmDeleteAction())
        {
            await ConfirmDeleteContact();
        }
    }

    /// <summary>
    /// Confirm delete action
    /// </summary>
    private async Task<bool> ConfirmDeleteAction()
    {
        // This would be handled by JS interop in real app
        return await Task.FromResult(true);
    }

    /// <summary>
    /// Perform actual delete
    /// Maps to WSP: DELETEsp=up_contacts_deleteContact
    /// Then redirects via WSP: REDIRECT=GETSECTION
    /// </summary>
    private async Task ConfirmDeleteContact()
    {
        try
        {
            isLoading = true;

            var deleteRequest = new ContactDeleteRequest
            {
                ContactId = deleteConfirmContact.ContactId,
                UserId = userId,
                SessionId = sessionId,
                Agency = agency
            };

            bool success = await ContactService.DeleteContactAsync(deleteRequest);

            if (success)
            {
                successMessage = $"Contact '{deleteConfirmContact.ContactName}' deleted successfully.";
                deleteConfirmContact = null;
                showDeleteConfirm = false;

                // Reload contacts (WSP: REDIRECT=GETSECTION)
                await ValidateAndLoadContacts();
            }
            else
            {
                errorMessage = "Error deleting contact. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting contact: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>
    /// Cancel delete operation
    /// </summary>
    private void CancelDelete()
    {
        deleteConfirmContact = null;
        showDeleteConfirm = false;
    }

    /// <summary>
    /// Dismiss validation alert
    /// </summary>
    private void DismissValidationAlert()
    {
        showValidationAlert = false;
    }
}

<style>
    .page-header {
        padding: 1rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 0.5rem;
    }

    .page-header h1 {
        font-weight: 600;
        font-size: 2rem;
    }

    .page-header small {
        color: rgba(255, 255, 255, 0.8);
    }

    .contacts-section {
        animation: fadeIn 0.3s ease-in;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
